PORT=3000
# Optional: saves finished games
DATABASE_URL=
# Optional: mirrors room snapshots; this server remains the single game authority
REDIS_URL=

# Frontend (Vercel): public URL of the separately deployed game server.
# Leave empty for local npm run dev or a combined Node deployment.
NEXT_PUBLIC_GAME_SERVER_URL=
# Standalone server: comma-separated allowed frontend origins (no trailing slash).
CLIENT_ORIGINS=https://game-psi-blond.vercel.app
